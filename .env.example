# Relay production configuration contract.
# Copy to .env and fill in. NEVER commit a filled .env.
# Canonical names are RELAY_*; aliases in comments are also accepted.

NODE_ENV=production

# --- required in production (fail-closed; no PGLite / memory / mock fallback) ---
POSTGRES_PASSWORD=
DATABASE_URL=postgres://relay:CHANGE_ME@postgres:5432/relay
REDIS_URL=redis://redis:6379

# Admin UI + Admin API. Alias: ADMIN_SECRET
RELAY_ADMIN_TOKEN=
# ADMIN_SECRET=
# Standalone /login page. Store only the colon-delimited scrypt hash, never plaintext.
RELAY_ADMIN_USERNAME=
RELAY_ADMIN_PASSWORD_HASH=
RELAY_REQUIRE_ADMIN_MFA=0
RELAY_ADMIN_TOTP_SECRET=
RELAY_ADMIN_SESSION_HOURS=12
RELAY_ALLOW_REMOTE_ADMIN_TOKEN_LOGIN=0
RELAY_ALLOW_REMOTE_ADMIN_BEARER=0
RELAY_REQUIRE_PRIVILEGED_SAAS_MFA=0
RELAY_SAAS_MFA_MAX_AGE_HOURS=24

# Worker poll credential. Alias: WORKER_SIGNING_KEY
RELAY_WORKER_TOKEN=
# WORKER_SIGNING_KEY=

# AES-256-GCM key for session/proxy secret store. Alias: SESSION_ENCRYPTION_KEY
RELAY_SECRETS_KEY=
# SESSION_ENCRYPTION_KEY=

# Public origin used in persisted media URLs. Alias: PUBLIC_BASE_URL
RELAY_PUBLIC_URL=https://relay.example.com
# PUBLIC_BASE_URL=

# Exact deployed commit. Use: git rev-parse HEAD
RELAY_RELEASE_SHA=
# Optional ISO-8601 artifact build time.
RELAY_BUILD_TIME=

# --- media ---
# local is FORBIDDEN in production. Use s3 (Amazon S3 / R2 / MinIO / OSS).
MEDIA_DRIVER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
# RELAY_S3_* names are equivalent.

# --- optional ---
LOG_LEVEL=info
MAX_WORKERS=8
MAX_WORKER_CONCURRENCY=3
PROVIDER_CANARY_ENABLED=true
RELAY_REQUIRE_ADMIN_LOGIN=1
RELAY_WORKER_DEAD_MS=20000
RELAY_CLAIM_GRACE_MS=4000
RELAY_QUEUE_CAP=200
RELAY_PROVIDER_QUEUE_CAP=100
RELAY_CHAT_QUEUE_CAP=100
RELAY_IMAGE_QUEUE_CAP=50
RELAY_KEY_QUEUE_CAP=20
# Account operations center: static 15m, proxy 30m, live structural 2h.
RELAY_ACCOUNT_CHECK_CONCURRENCY=2
RELAY_SKIP_ACCOUNT_CHECK_SCHEDULER=0
RELAY_SKIP_ACCOUNT_ANALYTICS=0

# --- commercial SaaS dark-launch gates ---
# Leave disabled until official provider contracts/credentials, active prices,
# 2+ gateways/workers, offsite backups and legal review are all complete.
# These three remain deployment hard gates even when a validated version is
# activated in /commercial-config.
RELAY_COMMERCIAL_ENABLED=0
RELAY_SAAS_REGISTRATION_ENABLED=0
RELAY_LEGAL_APPROVED=0
RELAY_SAAS_EMAIL_VERIFICATION_REQUIRED=1
RELAY_EMAIL_WEBHOOK_URL=
RELAY_GATEWAY_REPLICA_COUNT=1
RELAY_COMMERCIAL_MIN_WORKERS=2
# Separate operator hard gate for real-cost provider sandbox canaries.
RELAY_ALLOW_LIVE_PROVIDER_CANARY=0
RELAY_CANARY_MAX_CHARGE_MINOR=100
RELAY_PROVIDER_CANARY_MAX_AGE_HOURS=24

# Stripe Checkout. Production readiness requires a live secret/restricted key
# and the signing secret for POST /api/webhooks/stripe.
RELAY_PAYMENT_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RELAY_STRIPE_MAX_RECHARGE_MINOR=1000000
RELAY_ALLOW_MANUAL_CUSTOMER_ORDERS=0
# stripe_automatic or counsel-approved approved_exempt. Never leave
# unconfigured when enabling commercial traffic.
RELAY_TAX_MODE=unconfigured

# Official provider credentials. Consumer/web cookies are never accepted here.
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
LEONARDO_API_KEY=
# Logical Leonardo model -> official Production API model UUID.
LEONARDO_MODEL_MAP_JSON={}

# Persistent alert delivery (Slack/Teams/custom incident receiver).
RELAY_ALERT_WEBHOOK_URL=

# Offsite S3 backup target; distinct account/region from production object media.
RELAY_BACKUP_S3_ENDPOINT=
RELAY_BACKUP_S3_BUCKET=
RELAY_BACKUP_S3_ACCESS_KEY=
RELAY_BACKUP_S3_SECRET_KEY=

# Privacy/data retention. Billing ledger is retained for 7 years and is never
# deleted by the application retention task.
RELAY_REQUEST_CONTENT_RETENTION_DAYS=30
RELAY_SESSION_RETENTION_DAYS=30
RELAY_OPERATIONAL_RETENTION_DAYS=90
RELAY_AUDIT_RETENTION_DAYS=365
RELAY_SKIP_COMMERCIAL_MONITOR=0
RELAY_SKIP_PLAN_RENEWAL=0
RELAY_SKIP_RETENTION=0

# --- forbidden in production ---
# RELAY_DEMO_MODE=true
# RELAY_ALLOW_MOCK=1
# RELAY_TEST_URL=self
# RELAY_TEST_MODE=1

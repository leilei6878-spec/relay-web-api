FROM minio/mc:latest@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727 AS mc

FROM postgres:18-bookworm@sha256:1c59e2c3c818eaa0f0628f695b36e7c9e362d6b219b36a54a32df645cbd7e1af

RUN apt-get update \
  && apt-get install -y --no-install-recommends nodejs git ca-certificates \
  && git config --global --add safe.directory /workspace \
  && rm -rf /var/lib/apt/lists/*

COPY --from=mc /usr/bin/mc /usr/local/bin/mc

WORKDIR /workspace

ENTRYPOINT ["node", "scripts/offsite-backup.mjs"]
CMD ["/opt/backups"]

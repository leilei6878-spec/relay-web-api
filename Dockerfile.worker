FROM node:22-bookworm-slim AS dump
WORKDIR /app
COPY src/lib/local-worker-script.ts src/lib/local-worker-script.ts
COPY scripts/export-worker.mjs scripts/export-worker.mjs
RUN node --experimental-strip-types scripts/export-worker.mjs /tmp/relay-worker.py

FROM python:3.12-slim-bookworm
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libatk-bridge2.0-0 libdrm2 libxkbcommon0 libgbm1 libasound2 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libpango-1.0-0 libcairo2 \
    fonts-liberation ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir playwright \
  && python3 -m playwright install chromium
COPY --from=dump /tmp/relay-worker.py /app/workers/relay-worker.py
COPY docker/entrypoint-worker.sh /app/docker/entrypoint-worker.sh
ENV RELAY_HEADLESS=1
CMD ["sh", "/app/docker/entrypoint-worker.sh"]
